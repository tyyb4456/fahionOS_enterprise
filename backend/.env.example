# ── Database / cache ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fashionos:fashionos_dev@localhost:5432/fashionos
REDIS_URL=redis://localhost:6379/0

# ── Credentials ──────────────────────────────────────────────────────────────
FASHIONOS_ENCRYPTION_KEY=              # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FASHIONOS_ADMIN_SECRET=

# ── Clerk ────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=
API_BASE_URL=https://your-domain.com   # used to build Shopify webhook URLs

# ── Shopify OAuth ────────────────────────────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=

# ── Meta OAuth ───────────────────────────────────────────────────────────────
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v21.0

# ── Inventory Agent (new) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                     # used by langchain-anthropic
INVENTORY_AGENT_MODEL=claude-sonnet-5  # override to swap models per env
SHOPIFY_MCP_URL=http://localhost:8001/mcp
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Marketing Agent ──────────────────────────────────────────────────────────
META_MCP_URL=http://localhost:8002/mcp
MARKETING_CONTENT_MODEL=claude-sonnet-5

# ── Research Agent (new) ─────────────────────────────────────────────────────
RESEARCH_MCP_URL=http://localhost:8003/mcp
RESEARCH_ANALYSIS_MODEL=claude-sonnet-5
# One of these two enables research-mcp's web_search/news_search tools.
# Neither set -> tools return a clear "not configured" error instead of
# failing the whole agent run (same "optional infra" pattern as WHATSAPP_*/
# SENDGRID_API_KEY in notifications/dispatch.py).
TAVILY_API_KEY=
SERPER_API_KEY=

# ── Notifications (WhatsApp / Email) ─────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@fashionos.app

# ── Embeddings (RAG — Inventory/Sales/Marketing/Finance/Research policy + memory) ──
HUGGINGFACEHUB_API_TOKEN=              # https://huggingface.co/settings/tokens
EMBEDDING_MODEL=google/embeddinggemma-300m